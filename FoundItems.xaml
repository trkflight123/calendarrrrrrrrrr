<Window x:Class="calendarrrrrrrrrr.FoundItems"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Found Items"
        Width="1400"
        Height="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#C1E1C1">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#F1F3F6"/>
            <Setter Property="BorderBrush" Value="#D9DEE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#F1F3F6"/>
            <Setter Property="BorderBrush" Value="#D9DEE7"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BACK BUTTON -->
        <Button Width="58"
        Height="58"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Click="Back_Click"
        Background="#4A8150"
        BorderBrush="#4A8150"
        BorderThickness="2"
        Cursor="Hand"
        FontSize="28"
        FontWeight="Bold"
        Foreground="white"
        Content="←">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="16">

                        <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>


        <!-- TITLE -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

            <TextBlock Text="🧾"
                       FontSize="52"
                       Margin="0,0,15,0"/>

            <TextBlock Text="Lost and Found Items"
                       FontSize="38"
                       FontWeight="Bold"
                       Foreground="#1B1F24"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- BODY -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT TABLE PANEL -->
            <Border Grid.Column="0"
                    Background="#4A8150"
                    CornerRadius="14"
                    Padding="30">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="65"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="FoundItemsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Background="White"
                              BorderThickness="0"
                              FontSize="15"
                              RowHeight="58"
                              HeadersVisibility="Column" SelectionChanged="FoundItemsGrid_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Room"
                        Binding="{Binding RoomNumber}"
                        Width="120"/>

                            <DataGridTextColumn Header="Guest"
                        Binding="{Binding GuestName}"
                        Width="*"/>

                            <DataGridTextColumn Header="Item/s"
                        Binding="{Binding ItemName}"
                        Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="1"
                            Content="Claimed"
                            Width="120"
                            Height="45"
                            Background="#F4B32F"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Click="Claimed_Click"/> 
                </Grid>
            </Border>

            <!-- RIGHT FORM PANEL -->
            <Border Grid.Column="2"
                    Background="#4A8150"
                    CornerRadius="14"
                    Padding="30">

                <Border Background="White"
                        CornerRadius="8"
                        Padding="38">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Last Guest Attendee"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#1B1F24"
                                   HorizontalAlignment="Center"/>

                        <!-- ROOM -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,18">
                            <TextBlock Text="Room"/>
                            <TextBox x:Name="txtRoom"/>
                        </StackPanel>

                        <!-- LAST NAME + MI -->
                        <Grid Grid.Row="2" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Last Name"/>
                                <TextBox x:Name="txtLastName"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="M.I."/>
                                <TextBox x:Name="txtMI"/>
                            </StackPanel>
                        </Grid>
                        
                        <StackPanel Grid.Row="3" Margin="0,0,0,18">
                            <TextBlock Text="First Name"/>
                            <TextBox x:Name="txtFirstName"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Margin="0,0,0,18">
                            <TextBlock Text="Phone Number"/>
                            <TextBox x:Name="txtPhone"/>
                        </StackPanel>

                        <!-- DATES -->
                        <Grid Grid.Row="5" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel> 
                                <TextBlock Text="Check In Date"/>
                                <DatePicker x:Name="dpCheckIn"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Check Out Date"/>
                                <DatePicker x:Name="dpCheckOut"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="7">
                            <TextBlock Text="Item/s Found"/>
                            <TextBox x:Name="txtItemsFound"/>
                        </StackPanel>

                        <!-- BUTTONS -->
                        <Grid Grid.Row="8">
                            <Button Content="Clear"
                                    Width="90"
                                    Background="#E23D45"
                                    HorizontalAlignment="Left"
                                    Click="Clear_Click"/>

                            <Button Content="Save"
                                    Width="100"
                                    Background="#5B5BEA"
                                    HorizontalAlignment="Right"
                                    Click="Save_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>