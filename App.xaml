<Application x:Class="calendarrrrrrrrrr.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             StartupUri="Dashboard.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--           MODERN GREEN/GOLD PALETTE                    -->
            <!--      Hotel Yncierto Calendar - Client Ready            -->
            <!-- ═══════════════════════════════════════════════════════ -->

            <!-- PRIMARY GREEN (#649C6D) -->
            <Color x:Key="GreenPrimaryColor">#649C6D</Color>
            <Color x:Key="GreenPrimaryLight">#7AB37F</Color>
            <Color x:Key="GreenPrimaryDark">#4A7651</Color>
            <Color x:Key="GreenOverlay">#649C6D</Color>

            <!-- DARK GREEN (#2A5335) -->
            <Color x:Key="GreenDarkColor">#2A5335</Color>
            <Color x:Key="GreenDarkLight">#3A6341</Color>

            <!-- GOLD ACCENT (#E7C597) -->
            <Color x:Key="GoldAccentColor">#E7C597</Color>
            <Color x:Key="GoldAccentLight">#F0D9BB</Color>
            <Color x:Key="GoldAccentDark">#D4A877</Color>

            <!-- NEUTRALS & BACKGROUNDS -->
            <Color x:Key="BackgroundColor">#FFFFFF</Color>
            <Color x:Key="SurfaceColor">#F8F7F5</Color>
            <Color x:Key="SurfaceElevatedColor">#FAFAF8</Color>

            <!-- TEXT COLORS -->
            <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
            <Color x:Key="TextSecondaryColor">#666666</Color>
            <Color x:Key="TextTertiaryColor">#999999</Color>
            <Color x:Key="TextInverseColor">#FFFFFF</Color>

            <!-- SEMANTIC STATUS -->
            <Color x:Key="StatusAvailableColor">#649C6D</Color>
            <Color x:Key="StatusOccupiedColor">#D96B3B</Color>
            <Color x:Key="StatusUnavailableColor">#CCCCCC</Color>
            <Color x:Key="StatusPendingColor">#E7C597</Color>
            <Color x:Key="StatusCleaningColor">#7AAFCC</Color>
            <Color x:Key="StatusMaintenanceColor">#8B7B6E</Color>
            <Color x:Key="TextMutedColor">#999999</Color>

            <!-- DIVIDERS & BORDERS -->
            <Color x:Key="DividerColor">#E5E5E5</Color>
            <Color x:Key="BorderColor">#D0D0D0</Color>

            <!-- SUCCESS / ERROR / WARNING -->
            <Color x:Key="SuccessColor">#27AE60</Color>
            <Color x:Key="ErrorColor">#E74C3C</Color>
            <Color x:Key="WarningColor">#F39C12</Color>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--              BRUSHES (from colors)                     -->
            <!-- ═══════════════════════════════════════════════════════ -->

            <SolidColorBrush x:Key="GreenPrimaryBrush" Color="{StaticResource GreenPrimaryColor}"/>
            <SolidColorBrush x:Key="GreenPrimaryLightBrush" Color="{StaticResource GreenPrimaryLight}"/>
            <SolidColorBrush x:Key="GreenPrimaryDarkBrush" Color="{StaticResource GreenPrimaryDark}"/>
            <SolidColorBrush x:Key="GreenDarkBrush" Color="{StaticResource GreenDarkColor}"/>
            <SolidColorBrush x:Key="GoldAccentBrush" Color="{StaticResource GoldAccentColor}"/>
            <SolidColorBrush x:Key="GoldAccentLightBrush" Color="{StaticResource GoldAccentLight}"/>

            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}"/>

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
            <SolidColorBrush x:Key="TextInverseBrush" Color="{StaticResource TextInverseColor}"/>

            <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

            <SolidColorBrush x:Key="StatusAvailableBrush" Color="{StaticResource StatusAvailableColor}"/>
            <SolidColorBrush x:Key="StatusOccupiedBrush" Color="{StaticResource StatusOccupiedColor}"/>
            <SolidColorBrush x:Key="StatusUnavailableBrush" Color="{StaticResource StatusUnavailableColor}"/>
            <SolidColorBrush x:Key="StatusPendingBrush" Color="{StaticResource StatusPendingColor}"/>
            <SolidColorBrush x:Key="StatusCleaningBrush" Color="{StaticResource StatusCleaningColor}"/>
            <SolidColorBrush x:Key="StatusMaintenanceBrush" Color="{StaticResource StatusMaintenanceColor}"/>
            <SolidColorBrush x:Key="GoldPrimaryBrush" Color="{StaticResource GoldAccentColor}"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--              TYPOGRAPHY & DIMENSIONS                   -->
            <!-- ═══════════════════════════════════════════════════════ -->

            <FontFamily x:Key="UIFont">Segoe UI, -apple-system, BlinkMacSystemFont, San Francisco</FontFamily>
            <FontFamily x:Key="HeadingFont">Segoe UI, -apple-system, BlinkMacSystemFont</FontFamily>
            <FontFamily x:Key="DisplayFont">Segoe UI, -apple-system, BlinkMacSystemFont</FontFamily>

            <sys:Double x:Key="FontXS">11</sys:Double>
            <sys:Double x:Key="FontSM">12</sys:Double>
            <sys:Double x:Key="FontMD">14</sys:Double>
            <sys:Double x:Key="FontLG">16</sys:Double>
            <sys:Double x:Key="FontXL">18</sys:Double>
            <sys:Double x:Key="FontXXL">24</sys:Double>
            <sys:Double x:Key="FontXXXL">32</sys:Double>

            <CornerRadius x:Key="CornerRadiusXS">2</CornerRadius>
            <CornerRadius x:Key="CornerRadiusSM">4</CornerRadius>
            <CornerRadius x:Key="CornerRadiusMD">6</CornerRadius>
            <CornerRadius x:Key="CornerRadiusLG">8</CornerRadius>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--              GLOBAL APPLICATION STYLES                 -->
            <!-- ═══════════════════════════════════════════════════════ -->

            <!-- Main Window Style -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
                <Setter Property="FontSize" Value="{StaticResource FontMD}"/>
            </Style>

            <!-- ── Primary Button ── -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource GreenPrimaryBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="FontSize" Value="{StaticResource FontMD}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource CornerRadiusMD}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource GreenPrimaryDarkBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{StaticResource GreenDarkBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Secondary Button ── -->
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="FontSize" Value="{StaticResource FontMD}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource CornerRadiusMD}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F0F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Danger Button ── -->
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource CornerRadiusMD}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#C23030"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Gold Accent Button ── -->
            <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Background" Value="{StaticResource GoldAccentBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource GreenDarkBrush}"/>
            </Style>

            <!-- ── TextBox Modern Style ── -->
            <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="FontSize" Value="{StaticResource FontMD}"/>
                <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
                <Setter Property="CaretBrush" Value="{StaticResource GreenPrimaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource CornerRadiusMD}">
                                <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource GreenPrimaryLightBrush}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource GreenPrimaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── ComboBox Modern Style ── -->
            <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="FontSize" Value="{StaticResource FontMD}"/>
                <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            </Style>

            <!-- ── Card Style (Border) ── -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusLG}"/>
            </Style>

            <!-- ── Heading 1 TextBlock ── -->
            <Style x:Key="Heading1" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
                <Setter Property="FontSize" Value="{StaticResource FontXXXL}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <!-- ── Heading 2 TextBlock ── -->
            <Style x:Key="Heading2" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
                <Setter Property="FontSize" Value="{StaticResource FontXXL}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <!-- ── Heading 3 TextBlock ── -->
            <Style x:Key="Heading3" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
                <Setter Property="FontSize" Value="{StaticResource FontXL}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <!-- ── Body Text TextBlock ── -->
            <Style x:Key="BodyText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
                <Setter Property="FontSize" Value="{StaticResource FontMD}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="20"/>
            </Style>

            <!-- ── Caption TextBlock ── -->
            <Style x:Key="CaptionText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
                <Setter Property="FontSize" Value="{StaticResource FontXS}"/>
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            </Style>

            <!-- ── View page aliases ── -->
            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Heading2}"/>
            <Style x:Key="CaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"/>
            <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"/>
            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
                <Setter Property="FontSize" Value="{StaticResource FontXS}"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="StatCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="Padding" Value="20"/>
                <Setter Property="MinWidth" Value="160"/>
            </Style>
            <Style x:Key="GoldProgressBarStyle" TargetType="ProgressBar">
                <Setter Property="Height" Value="6"/>
                <Setter Property="Background" Value="#F0F0F0"/>
                <Setter Property="Foreground" Value="{StaticResource GoldPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <!-- ── Tooltip ── -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{StaticResource GreenDarkBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSM}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource CornerRadiusMD}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
