<Window x:Class="HotelYnCierto.ReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Reservations"
       Icon="Assets/bookroom.png"
        Width="500"
        Height="849"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#C1E1C1">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2D2D2D"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#ECEEE9"/>
            <Setter Property="BorderBrush" Value="#D8DDD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#ECEEE9"/>
            <Setter Property="BorderBrush" Value="#D8DDD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#E5E5E5"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CFCFCF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Width" Value="85"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <iconPacks:PackIconMaterial Kind="BookPlus"
                                        Width="34"
                                        Height="34"
                                        Foreground="#4A8150"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"/>

            <TextBlock Text="Reservations"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#4A8150"/>
        </StackPanel>

        <!-- MAIN CONTAINER -->
        <Border Grid.Row="1"
                Background="#4A8150"
                Padding="18"
                CornerRadius="8">

            <Border Background="#F8F8F6"
                    CornerRadius="8"
                    Padding="28">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Reservation Form"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#4A8150"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,25"/>

                        <!-- LAST NAME + MI -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Last Name" FontSize="12"/>
                                <TextBox x:Name="txtLastName"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="M.I." FontSize="12"/>
                                <TextBox x:Name="txtMI"/>
                            </StackPanel>
                        </Grid>

                        <!-- FIRST NAME -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="First Name" FontSize="12"/>
                            <TextBox x:Name="txtFirstName"/>
                        </StackPanel>

                        <!-- PHONE -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Phone Number" FontSize="12"/>
                            <TextBox x:Name="txtPhone"/>
                        </StackPanel>

                        <!-- EMAIL -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Email Address" FontSize="12"/>
                            <TextBox x:Name="txtEmail"/>
                        </StackPanel>

                        <!-- ADDRESS -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Address" FontSize="12"/>
                            <TextBox x:Name="txtAddress"/>
                        </StackPanel>

                        <!-- DATES -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Check In Date" FontSize="12"/>
                                <DatePicker x:Name="dpCheckIn"
                                            SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Check Out Date" FontSize="12"/>
                                <DatePicker x:Name="dpCheckOut"
                                            SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- ROOM TYPE -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Room Type" FontSize="12"/>
                            <ComboBox x:Name="cmbRoomType"
                                      SelectedIndex="-1"
                                      SelectionChanged="cmbRoomType_SelectionChanged">
                                <ComboBoxItem Content="Standard"/>
                                <ComboBoxItem Content="Deluxe"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- ROOM AVAILABLE + RATE -->
                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Room Available" FontSize="12"/>
                                <ComboBox x:Name="cmbAvailable"
                                          SelectedIndex="-1"
                                          DisplayMemberPath="RoomNumber"
                                          SelectionChanged="cmbAvailable_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Room Rate" FontSize="12"/>
                                <TextBox x:Name="txtRoomRate"
                                         IsReadOnly="True"/>
                            </StackPanel>
                        </Grid>

                        <!-- BUTTONS -->
                        <Grid>
                            <Button Background="#D94B4B"
                                    HorizontalAlignment="Left"
                                    Click="BtnClear_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Eraser" Width="14" Height="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Clear"/>
                                </StackPanel>
                            </Button>

                            <Button Background="#4A8150"
                                    HorizontalAlignment="Right"
                                    Click="BtnBook_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="CheckCircleOutline" Width="14" Height="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Book"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                    </StackPanel>

                </ScrollViewer>

            </Border>
        </Border>
    </Grid>
</Window>