<Window x:Class="HotelYnCierto.ReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reservation"
        Width="500"
        Height="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#C1E1C1">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2D2D2D"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#ECEEE9"/>
            <Setter Property="BorderBrush" Value="#D8DDD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#ECEEE9"/>
            <Setter Property="BorderBrush" Value="#D8DDD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#E5E5E5"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CFCFCF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Width" Value="85"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="85"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="▣"
                       FontSize="34"
                       Foreground="#4A8150"
                       Margin="0,0,10,0"/>

            <TextBlock Text="Reservations"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#4A8150"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#4A8150"
                Padding="18"
                CornerRadius="8">

            <Border Background="#F8F8F6"
                    CornerRadius="8"
                    Padding="28">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="45"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Reservation Form"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#4A8150"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- LAST NAME + MI -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="95"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Last Name" FontSize="12"/>
                            <TextBox x:Name="txtLastName"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="M.I." FontSize="12"/>
                            <TextBox x:Name="txtMI"/>
                        </StackPanel>
                    </Grid>

                    <!-- FIRST NAME -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="First Name" FontSize="12"/>
                        <TextBox x:Name="txtFirstName"/>
                    </StackPanel>

                    <!-- PHONE -->
                    <StackPanel Grid.Row="3">
                        <TextBlock Text="Phone Number" FontSize="12"/>
                        <TextBox x:Name="txtPhone"/>
                    </StackPanel>

                    <!-- DATES -->
                    <Grid Grid.Row="5" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Check In Date" FontSize="12"/>
                            <DatePicker x:Name="dpCheckIn"
                                        SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Check Out Date" FontSize="12"/>
                            <DatePicker x:Name="dpCheckOut"
                                        SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- ROOM TYPE -->
                    <StackPanel Grid.Row="7" Margin="0,0,0,12">
                        <TextBlock Text="Room Type" FontSize="12"/>
                        <ComboBox x:Name="cmbRoomType"
                                  SelectedIndex="-1"
                                  SelectionChanged="cmbRoomType_SelectionChanged">
                            <ComboBoxItem Content="Standard"/>
                            <ComboBoxItem Content="Family"/>
                            <ComboBoxItem Content="Deluxe"/>
                            <ComboBoxItem Content="Suite"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- ROOM AVAILABLE + RATE -->
                    <Grid Grid.Row="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Room Available" FontSize="12"/>
                            <ComboBox x:Name="cmbAvailable"
                                      SelectedIndex="-1"
                                      DisplayMemberPath="RoomNumber"
                                      SelectionChanged="cmbAvailable_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Room Rate" FontSize="12"/>
                            <TextBox x:Name="txtRoomRate"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- BUTTONS -->
                    <Grid Grid.Row="11">
                        <Button Content="Clear"
                                Background="#D94B4B"
                                HorizontalAlignment="Left"
                                Click="BtnClear_Click"/>

                        <Button Content="Book"
                                Background="#4A8150"
                                HorizontalAlignment="Right"
                                Click="BtnBook_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>