<Window x:Class="calendarrrrrrrrrr.LogIn"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotel Yncierto"
        Width="620"
        Height="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="18"
            Background="#0F241F"
            BorderBrush="#2F6B5D"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Background="#162D27"
                    CornerRadius="18,18,0,0"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">

                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Image Source="Assets/logo.png"
                               Width="38"
                               Height="38"
                               Stretch="Uniform"/>

                        <TextBlock Text="Hotel Yncierto"
                                   Foreground="White"
                                   FontSize="20"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button Content="—"
                                Width="45"
                                Height="40"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="24"
                                Click="Minimize_Click"/>

                        <Button Content="×"
                                Width="45"
                                Height="40"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="30"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- LOGIN CONTENT -->
            <StackPanel Grid.Row="1"
                        Margin="55,30,55,45">

                <Image Source="Assets/logo.png"
                       Width="120"
                       Height="120"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"/>

                <TextBlock Text="HOTEL"
                           Foreground="#D7A75A"
                           FontSize="34"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>

                <TextBlock Text="YNCIERTO"
                           Foreground="#D7A75A"
                           FontSize="38"
                           FontWeight="SemiBold"
                          
                           HorizontalAlignment="Center"/>

                <TextBlock Text="FRONTDESK LOGIN"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           
                           HorizontalAlignment="Center"
                           Margin="0,10,0,35"/>

                <!-- USERNAME -->
                <Border Height="58"
                        CornerRadius="10"
                        BorderBrush="#55645F"
                        BorderThickness="1"
                        Background="#142A24"
                        Margin="0,0,0,18">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="👤"
                                   Foreground="#D1D5DB"
                                   FontSize="22"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <TextBox x:Name="txtUsername"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontSize="18"
                                 VerticalContentAlignment="Center"
                                 Padding="0"
                                 Text="Username"/>
                    </Grid>
                </Border>

                <!-- PASSWORD -->
                <Border Height="58"
                        CornerRadius="10"
                        BorderBrush="#55645F"
                        BorderThickness="1"
                        Background="#142A24"
                        Margin="0,0,0,22">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="🔒"
                                   Foreground="#D1D5DB"
                                   FontSize="22"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <PasswordBox x:Name="txtPassword"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     FontSize="18"
                                     VerticalContentAlignment="Center"
                                     Padding="0"/>

                        <TextBlock Grid.Column="2"
                                   Text="👁"
                                   Foreground="#D1D5DB"
                                   FontSize="20"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- REMEMBER / FORGOT -->
                <Grid Margin="0,0,0,28">
                    <CheckBox Content="Remember me"
                              Foreground="White"
                              FontSize="15"
                              VerticalAlignment="Center"/>

                    <TextBlock Text="Forgot password?"
                               Foreground="#43C6A3"
                               FontSize="15"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- LOGIN BUTTON -->
                <Button Content="↪  LOG IN"
                        Height="62"
                        Background="#0E6B50"
                        Foreground="White"
                        FontSize="22"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Login_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    BorderBrush="#41C79D"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</Window>