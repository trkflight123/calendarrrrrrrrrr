<Window x:Class="calendarrrrrrrrrr.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Hotel Yncierto — Availability Calendar"
        Icon="Assets/logo.png"
        Height="900" Width="1400"
        MinHeight="768" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UIFont}"
        FontSize="{StaticResource FontMD}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Calendar Day Template -->
        <DataTemplate x:Key="CalendarDayTemplate">
            <Border Background="{Binding DayBackground}"
                    BorderBrush="{Binding StatusBorderBrush}"
                    BorderThickness="{Binding StatusBorderThickness}"
                    CornerRadius="{StaticResource CornerRadiusMD}"
                    Margin="3"
                    MinHeight="96"
                    MinWidth="72"
                    ClipToBounds="True"
                    Cursor="{Binding DayCursor}"
                    MouseLeftButtonUp="DayCell_MouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#40000000" BlurRadius="6" ShadowDepth="1" Opacity="0.15"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ToolTip>
                    <StackPanel Orientation="Vertical" Margin="0">
                        <TextBlock Text="{Binding DateDisplay}" FontWeight="Bold" FontSize="{StaticResource FontMD}"/>
                        <TextBlock Text="{Binding StatusSummary}" FontSize="{StaticResource FontSM}"
                                   Visibility="{Binding ShowDayStatus, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="Click to view or update rooms" FontSize="{StaticResource FontSM}" Margin="0,4,0,0"
                                   Visibility="{Binding ShowDayStatus, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border.ToolTip>

                <Grid Margin="5,5,5,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding DayNumber}" 
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{Binding DayNumberColor}"/>

                    <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource DividerBrush}" Margin="0,4,0,4"
                               Visibility="{Binding ShowDayStatus, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Grid.Row="2"
                               Text="{Binding DayStatusLine}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Top"
                               Visibility="{Binding ShowDayStatus, Converter={StaticResource BoolToVis}}"/>

                    <Border Grid.Row="3"
                            Height="4"
                            CornerRadius="2"
                            Margin="0,4,0,0"
                            VerticalAlignment="Bottom"
                            Background="{Binding StatusStripBrush}"
                            Visibility="{Binding ShowDayStatus, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═════════════════════════════════════════════════════════ -->
        <!--                      HEADER                              -->
        <!-- ═════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" 
                Background="#4A8150"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="40,24,40,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- BACK BUTTON + TITLE -->
                <StackPanel Grid.Column="0"
            Grid.Row="0"
            Orientation="Horizontal"
            VerticalAlignment="Center">

                    <!-- BACK BUTTON -->
                    <Button x:Name="BtnBack"
        Width="50"
        Height="50"
        Margin="0,0,20,0"
        Background="#5C8E63"
        BorderThickness="0"
        Cursor="Hand"
        Click="BtnBack_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    CornerRadius="14">

                                    <Viewbox Width="18" Height="18">
                                        <TextBlock Text="←"
                               Foreground="White"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                                    </Viewbox>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                            Property="Background"
                            Value="#4A8150"/>
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border"
                            Property="Background"
                            Value="#3C6B42"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- LOGO -->
                    <Image Source="Assets/logo.png"
           Width="48"
           Height="48"
           Margin="0,0,12,0"
           Stretch="Uniform"
           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- TITLE -->
                    <StackPanel Orientation="Vertical"
                VerticalAlignment="Center">

                        <TextBlock Text="Hotel Yncierto"
                   Foreground="#D0A273"
                   Style="{StaticResource Heading2}"/>

                        <TextBlock Text="Room Availability Calendar"
                   Foreground="white"
                   Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Month Navigation Controls -->
                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPrevMonth" Content="‹ Previous" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,8" FontSize="{StaticResource FontMD}"
                            Margin="0,0,8,0"
                            Click="BtnPrevMonth_Click"/>
                    <TextBlock x:Name="TxtCurrentMonth" 
                               Text="October 2024"
                               Foreground="white"
                               Style="{StaticResource Heading3}"
                               Margin="8,0"
                               MinWidth="120"
                               TextAlignment="Center"/>
                    <Button x:Name="BtnNextMonth" Content="Next ›" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,8" FontSize="{StaticResource FontMD}"
                            Margin="0,0,8,0"
                            Click="BtnNextMonth_Click"/>
                    <Button x:Name="BtnToday" Content="Today" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="12,8" FontSize="{StaticResource FontMD}"
                            Click="BtnToday_Click"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnNewBooking"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="14,10,14,10" FontSize="{StaticResource FontMD}"
                            Margin="0,0,12,0"
                            Click="BtnNewBooking_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="BookPlus" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="New Booking"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnManageRooms"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,8"
                            FontSize="{StaticResource FontMD}"
                            Margin="0,0,12,0"
                            Click="BtnManageRooms_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="BedDouble" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Manage Rooms"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAddRoom"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,8"
                            FontSize="{StaticResource FontMD}"
                            Click="BtnAddRoom_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PlusCircleOutline" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Add Room"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Filters & Legend -->
                <ScrollViewer Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3"
                              Margin="0,16,0,0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <!-- Room Type Filter -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Filter by Type:" FontWeight="SemiBold" Foreground="white" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbRoomType" 
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  Width="120" Height="32"
                                  SelectedIndex="0"
                                  SelectionChanged="CmbRoomType_SelectionChanged">
                            <ComboBoxItem>All Rooms</ComboBoxItem>
                            <ComboBoxItem>Standard</ComboBoxItem>
                            <ComboBoxItem>Deluxe</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Day color legend -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <Border Width="14" Height="14" CornerRadius="2" Background="#649C6D" BorderBrush="#4A7A52" BorderThickness="2,0,0,0" Margin="0,0,6,0"/>
                        <TextBlock Text="All open" Foreground="White" FontSize="11" Margin="0,0,14,0"/>
                        <Border Width="14" Height="14" CornerRadius="2" Background="#E7C597" BorderBrush="#C9A86E" BorderThickness="2,0,0,0" Margin="0,0,6,0"/>
                        <TextBlock Text="Mixed" Foreground="White" FontSize="11" Margin="0,0,14,0"/>
                        <Border Width="14" Height="14" CornerRadius="2" Background="#D96B3B" BorderBrush="#B85530" BorderThickness="2,0,0,0" Margin="0,0,6,0"/>
                        <TextBlock Text="Fully booked" Foreground="White" FontSize="11" Margin="0,0,14,0"/>
                    </StackPanel>

                    <!-- Statistics -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                            <Border Background="{StaticResource StatusAvailableBrush}" Width="12" Height="12" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="Open today" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtAvailCount" Text="0" FontWeight="Bold" Foreground="#C1E1C1"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                            <Border Background="{StaticResource StatusOccupiedBrush}" Width="12" Height="12" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="Booked today" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtOccupiedCount" Text="0" FontWeight="Bold" Foreground="{StaticResource StatusOccupiedBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource StatusUnavailableBrush}" Width="12" Height="12" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="Out of service" Foreground="black" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtUnavailCount" Text="0" FontWeight="Bold" Foreground="Black"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═════════════════════════════════════════════════════════ -->
        <!--                    CALENDAR GRID                         -->
        <!-- ═════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Padding="40,20,40,40" Background="#C1E1C1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Day-of-Week Headers -->
                <Grid Grid.Row="0" Height="44" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Sunday" Style="{StaticResource Heading3}" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource GreenPrimaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="Monday" Style="{StaticResource Heading3}" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource GreenPrimaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="Tuesday" Style="{StaticResource Heading3}" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource GreenPrimaryBrush}"/>
                    <TextBlock Grid.Column="3" Text="Wednesday" Style="{StaticResource Heading3}" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource GreenPrimaryBrush}"/>
                    <TextBlock Grid.Column="4" Text="Thursday" Style="{StaticResource Heading3}" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource GreenPrimaryBrush}"/>
                    <TextBlock Grid.Column="5" Text="Friday" Style="{StaticResource Heading3}" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource GreenPrimaryBrush}"/>
                    <TextBlock Grid.Column="6" Text="Saturday" Style="{StaticResource Heading3}" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource GreenPrimaryBrush}"/>
                </Grid>

                <!-- Calendar Days Grid -->
                <ItemsControl x:Name="CalendarDaysControl" 
                              Grid.Row="1"
                              ItemTemplate="{StaticResource CalendarDayTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" SnapsToDevicePixels="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</Window>
