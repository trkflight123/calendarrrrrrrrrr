<Window x:Class="HotelYnCierto.AddRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Room"
        Icon="Assets/addroom.png"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Width="430"
        Height="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#C1E1C1">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="#F1F3EF"/>
            <Setter Property="BorderBrush" Value="#D8DDD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="#F1F3EF"/>
            <Setter Property="BorderBrush" Value="#D8DDD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <iconPacks:PackIconMaterial Kind="PlusCircleOutline"
                       FontSize="30"
                       Foreground="#4A8150"
                       Margin="0,0,10,0" Height="33" Width="41"/>

            <TextBlock Text="Add Room"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#4A8150"/>
        </StackPanel>

        <!-- CARD -->
        <Border Grid.Row="1"
                Background="#4A8150"
                CornerRadius="16"
                Padding="14">

            <Border Background="#F8F8F6"
                    CornerRadius="14"
                    Padding="24">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Room Information"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#4A8150"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,24"/>

                        <TextBlock Text="Room Number" FontSize="12"/>
                        <TextBox x:Name="txtRoomNumber" Margin="0,3,0,12"/>

                        <TextBlock Text="Room Type" FontSize="12"/>
                        <ComboBox x:Name="cmbRoomType" SelectedIndex="-1" Margin="0,3,0,12">
                            <ComboBoxItem Content="Standard Room"/>
                            <ComboBoxItem Content="Deluxe Room"/>
                        </ComboBox>

                        <TextBlock Text="Room Rate" FontSize="12"/>
                        <TextBox x:Name="txtRoomRate" Margin="0,3,0,12"/>

                        <TextBlock Text="Capacity" FontSize="12"/>
                        <ComboBox x:Name="cmbCapacity" SelectedIndex="-1" Margin="0,3,0,12">
                            <ComboBoxItem Content="1 Person"/>
                            <ComboBoxItem Content="2 Persons"/>
                            <ComboBoxItem Content="3 Persons"/>
                            <ComboBoxItem Content="4 Persons"/>
                            <ComboBoxItem Content="5 Persons"/>
                        </ComboBox>

                        <TextBlock Text="Room Status" FontSize="12"/>
                        <ComboBox x:Name="cmbStatus" SelectedIndex="-1" Margin="0,3,0,14">
                            <ComboBoxItem Content="Available"/>
                            <ComboBoxItem Content="Occupied"/>
                            <ComboBoxItem Content="Unavailable"/>
                            <ComboBoxItem Content="Maintenance"/>
                        </ComboBox>

                        <TextBlock Text="Room Photo" FontSize="12" Margin="0,0,0,6"/>

                        <Border Height="130"
                                Background="#ECEEE9"
                                BorderBrush="#D8DDD5"
                                BorderThickness="1"
                                CornerRadius="10">

                            <Image x:Name="imgRoomPhoto"
                                   Stretch="UniformToFill"/>
                        </Border>

                        <Button Content="Upload Photo"
                                Width="130"
                                Background="#4A8150"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,24"
                                Click="BtnUploadPhoto_Click"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Content="Clear"
                                    Grid.Column="0"
                                    Background="#D94B4B"
                                    Click="BtnClear_Click"/>

                            <Button Content="Save"
                                    Grid.Column="2"
                                    Background="#4A8150"
                                    Click="BtnSave_Click"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</Window>