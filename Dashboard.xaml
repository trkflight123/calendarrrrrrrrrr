<Window x:Class="calendarrrrrrrrrr.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotel Yncierto Dashboard"
        Width="1400"
        Height="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#C1E1C1">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Background="#4A8150">
            <StackPanel Margin="0,25,0,25">

                <!-- LOGO + TITLE -->
                <StackPanel Orientation="Horizontal"
                    Margin="20,20,20,40"
                    VerticalAlignment="Center">

                    <Image Source="Assets/logo.png"
                   Width="55"
                   Height="55"
                   Stretch="Uniform"
                   Margin="0,0,12,0"/>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Hotel Yncierto"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#D0A273"/>

                        <TextBlock Text="Management System"
                           Foreground="White"
                           FontSize="13"/>
                    </StackPanel>
                </StackPanel>

                <!-- BUTTONS -->
                <Button Content="Dashboard"
                Height="45"
                Margin="20,0,20,12"
                Click="Dashboard_Click"/>

                <Button Content="Calendar"
                Height="45"
                Margin="20,0,20,12"
                Click="Calendar_Click"/>

                <Button Content="Guest"
                Height="45"
                Margin="20,0,20,12"
                Click="Guest_Click"/>

                <Button Content="Logout"
                Height="45"
                Margin="20,360,20,0"
                Click="Logout_Click"/>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Dashboard"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="#4A8150"
                       VerticalAlignment="Center"/>

            <!-- ROOMS -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RoomsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="320"
                                    Height="360"
                                    Background="#F8F8F6"
                                    CornerRadius="12"
                                    Margin="10"
                                    Padding="15">

                                <StackPanel>
                                    <Border Height="180"
                                            CornerRadius="10"
                                            Background="#E6E6E6"
                                            ClipToBounds="True">
                                        <Image Source="{Binding ImagePath}"
                                               Stretch="UniformToFill"/>
                                    </Border>

                                    <TextBlock Text="{Binding RoomName}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#4A8150"
                                               Margin="0,14,0,6"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Capacity}"
                                               FontSize="14"
                                               Foreground="#333"/>

                                    <TextBlock Text="{Binding Status}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#4A8150"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="{Binding Price}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#D0A273"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ABOUT US -->
            <Border Grid.Row="2"
                    Background="#F8F8F6"
                    CornerRadius="12"
                    Padding="20"
                    Margin="10,20,10,0">

                <StackPanel>
                    <TextBlock Text="About Us"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#4A8150"/>

                    <TextBlock Text=""
                               FontSize="14"
                               Foreground="#333"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>