<Window x:Class="calendarrrrrrrrrr.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotel Yncierto — Dashboard"
        Icon="Assets/logo.png"
        Width="1400"
        Height="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#C1E1C1"
        WindowState="Maximized">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Background="#F8F8F6"
        BorderBrush="#4A8150"
        BorderThickness="1">

            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- PROFILE -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,45">
                    <Image Source="Assets/logo.png"
                   Width="58"
                   Height="58"
                   Stretch="Uniform"/>

                    <StackPanel Margin="12,7,0,0">
                        <TextBlock Text="Hotel Yncierto"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="Black"/>

                        <TextBlock Text="Front Desk"
                           FontSize="13"
                           Foreground="#6B7280"/>
                    </StackPanel>
                </StackPanel>

                <!-- MENU -->
                <StackPanel Grid.Row="1">

                    <Button Content="🏠  Dashboard"
                    Height="45"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Left"
                    FontSize="14"
                    Margin="0,0,0,14"
                    Click="Dashboard_Click"/>

                    <Button Content="📅  Calendar/Reservation"
                    Height="45"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Left"
                    FontSize="14"
                    Margin="0,0,0,14"
                    Click="Calendar_Click"/>

                    <Button Content="👤  Guest"
                    Height="45"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Left"
                    FontSize="14"
                    Margin="0,0,0,14"
                    Click="Guest_Click"/>

                    

                    <TextBlock Text="Others"
                       FontWeight="Bold"
                       FontSize="14"
                       Margin="0,0,0,14"/>

                    <Button Content="📦  Found Items"
                    Height="45"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Left"
                    FontSize="14"
                    Margin="0,0,0,14" Click="Button_Click"/>

                    <Button Content="🎉  Events"
                    Height="45"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Left"
                    FontSize="14"/>
                </StackPanel>

                <!-- LOGOUT -->
                <Button Grid.Row="2"
                Content="↩  Log out"
                Height="55"
                Background="White"
                BorderBrush="#4A8150"
                BorderThickness="1"
                Foreground="#4A8150"
                FontSize="14"
                FontWeight="SemiBold"
                Click="Logout_Click"/>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="361*"/>
                <ColumnDefinition Width="189*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.ColumnSpan="2">
                <TextBlock Text="{Binding Greeting}"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="Black"/>
            </StackPanel>

            <!-- DASHBOARD BODY -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT CARDS -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="390"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- AVAILABLE ROOMS -->
                    <Border Grid.Row="0"
            Background="#4A8150"
            CornerRadius="10"
            Padding="18">

                        <ItemsControl x:Name="RoomsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Height="220"
                                CornerRadius="8"
                                ClipToBounds="True"
                                Background="#EAEAEA">

                                            <Image Source="{Binding ImagePath}"
                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="{Binding RoomName}"
                                       Foreground="#FFD65A"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"/>

                                            <TextBlock Text="{Binding Price}"
                                       Foreground="#FFD65A"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>

                                            <TextBlock Text="{Binding Capacity}"
                                       Foreground="#FFD65A"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>

                                            <TextBlock Text="{Binding Status}"
                                       Foreground="#FFD65A"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <TextBlock Text="•••"
                                   Foreground="#1F4A2A"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- ABOUT US -->
                    <Border Grid.Row="2"
            Background="#4A8150"
            CornerRadius="10"
            Padding="28">

                        <StackPanel>
                            <TextBlock Text="ⓘ About Us"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"/>

                            <TextBlock Text=""
                       FontSize="15"
                       Foreground="White"
                       Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- RIGHT STATUS CARD -->
                <Border Grid.Column="2"
                        Background="#4A8150"
                        CornerRadius="10"
                        Padding="35">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="70"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Room Status for Today"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#1F4A2A"
                                   VerticalAlignment="Center"/>

                        <DataGrid Grid.Row="1"
                              x:Name="RoomStatusGrid"
                              AutoGenerateColumns="False"
                              Background="White"
                              BorderThickness="0"
                              FontSize="14"

                              IsReadOnly="True"
                              CanUserResizeColumns="False"
                              CanUserResizeRows="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"

                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Room"
                                                    Binding="{Binding RoomName}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Room Type"
                                                    Binding="{Binding RoomType}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Room Capacity"
                                                    Binding="{Binding Capacity}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding Status}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Grid.Row="2"
                                Content="See more"
                                Width="130"
                                Height="45"
                                Background="#008B8B"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>