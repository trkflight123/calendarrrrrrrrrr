<Window x:Class="calendarrrrrrrrrr.Events"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Events"
        Width="1400"
        Height="900"
        MinWidth="1150"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#C1E1C1"
        ResizeMode="CanResize">

    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">

        <Grid Margin="35"
              MinWidth="1080"
              MinHeight="690">

            <Grid.RowDefinitions>
                <RowDefinition Height="85"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button Content="←"
                        Width="55"
                        Height="55"
                        Background="#4A8150"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="24"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="Back_Click"/>

                <TextBlock Text="📅"
                           FontSize="38"
                           Margin="25,0,12,0"/>

                <TextBlock Text="Events"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#10201A"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- BODY -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT EVENT LIST -->
                <Border Grid.Column="0"
                        Background="#4A8150"
                        CornerRadius="18"
                        Padding="22">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="EventsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F4F3FF"
                                            CornerRadius="18"
                                            Padding="24"
                                            Height="260"
                                            Margin="0,0,0,22">

                                        <StackPanel>
                                            <TextBlock Text="{Binding EventDateText}"
                                                       Foreground="#4A8150"
                                                       FontWeight="Bold"
                                                       FontSize="17"/>

                                            <TextBlock Text="{Binding EventName}"
                                                       Foreground="#5B5BEA"
                                                       FontWeight="Bold"
                                                       FontSize="18"
                                                       Margin="0,10,0,14"/>

                                            <TextBlock Text="{Binding EventTimeText}"
                                                       Foreground="#4B5563"
                                                       FontSize="15"
                                                       Margin="0,0,0,10"/>

                                            <TextBlock Text="⌖  Hotel Yncierto"
                                                       Foreground="#4B5563"
                                                       FontSize="15"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- RIGHT SIDE -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <!-- CALENDAR CARD -->
                    <Border Grid.Row="0"
                            Background="#4A8150"
                            CornerRadius="18"
                            Padding="20">

                        <Border Background="White"
                                CornerRadius="20"
                                Padding="32">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- CALENDAR HEADER -->
                                <Grid>
                                    <TextBlock x:Name="txtMonthTitle"
                                               Text="May 2026"
                                               FontSize="32"
                                               FontWeight="Bold"
                                               Foreground="#111827"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">

                                        <Button Content="‹"
                                                Width="42"
                                                Height="42"
                                                Background="#F3F4F6"
                                                Foreground="#4A8150"
                                                BorderThickness="0"
                                                FontSize="26"
                                                FontWeight="Bold"
                                                Cursor="Hand"
                                                Click="PrevMonth_Click"/>

                                        <Button Content="›"
                                                Width="42"
                                                Height="42"
                                                Margin="10,0,0,0"
                                                Background="#F3F4F6"
                                                Foreground="#4A8150"
                                                BorderThickness="0"
                                                FontSize="26"
                                                FontWeight="Bold"
                                                Cursor="Hand"
                                                Click="NextMonth_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- CALENDAR DAYS -->
                                <UniformGrid Grid.Row="1"
                                             x:Name="CalendarDaysPanel"
                                             Columns="7"
                                             Rows="7"
                                             Margin="0,15,0,0"/>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- ADD EVENT -->
                    <Border Grid.Row="2"
                            Background="#4A8150"
                            CornerRadius="18"
                            Padding="24">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="55"/>
                                <RowDefinition Height="65"/>
                                <RowDefinition Height="65"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Add Event"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <!-- DATE AND TIME -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Date"
                                           Foreground="White"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                <DatePicker x:Name="dpEventDate"
                                            Grid.Column="1"
                                            Height="42"
                                            Background="White"
                                            Foreground="Black"
                                            FontSize="15"
                                            VerticalContentAlignment="Center" Margin="50,0,0,0"/>

                                <TextBlock Text="Time"
                                           Grid.Column="2"
                                           Foreground="White"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBox x:Name="txtEventTime"
                                         Grid.Column="3"
                                         Height="42"
                                         Background="White"
                                         Foreground="Black"
                                         Padding="12,0"
                                         VerticalContentAlignment="Center"/>
                            </Grid>

                            <!-- EVENT NAME -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Event Name"
                                           Foreground="White"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                <TextBox x:Name="txtEventName"
                                         Grid.Column="1"
                                         Height="42"
                                         Background="White"
                                         Foreground="Black"
                                         Padding="12,0"
                                         VerticalContentAlignment="Center"/>
                            </Grid>

                            <!-- BUTTON -->
                            <Button Grid.Row="3"
                                    Content="Add"
                                    Width="110"
                                    Height="45"
                                    Background="#F4B32F"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    FontSize="16"
                                    Cursor="Hand"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Click="AddEvent_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>