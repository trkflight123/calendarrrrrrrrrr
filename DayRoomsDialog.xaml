<Window x:Class="calendarrrrrrrrrr.DayRoomsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Wednesday, May 1, 2026"
        Icon="Assets/logo.png"
        Width="540"
        Height="520"
        MinWidth="500"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#C1E1C1"
        d:DesignHeight="520"
        d:DesignWidth="540">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <iconPacks:PackIconMaterial Kind="CalendarToday"
                                            Width="24"
                                            Height="24"
                                            Foreground="#4A8150"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtSummary"
                           Text="5 open · 2 booked"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#2D2D2D"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Book an open room, clear a booking, or mark a room ready for guests."
                       FontSize="12"
                       Foreground="#555"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Room list -->
        <Border Grid.Row="1"
                Background="#F8F8F6"
                CornerRadius="8"
                Padding="10"
                BorderBrush="#D8DDD5"
                BorderThickness="1">
            <ListBox x:Name="RoomsList"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E5E5E5"
                                BorderThickness="0,0,0,1"
                                Padding="4,10,4,12"
                                Margin="0,0,0,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="#2D2D2D"/>
                                    <TextBlock Text="{Binding DetailLine}"
                                               FontSize="12"
                                               Foreground="{Binding StatusColor}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <WrapPanel Grid.Row="1"
                                           HorizontalAlignment="Right"
                                           Orientation="Horizontal">

                                    <Button Padding="10,5"
                                            Margin="0,0,6,6"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Visibility="{Binding CanBook, Converter={StaticResource BoolToVis}}"
                                            Click="Book_Click"
                                            Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="BookPlus" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Book" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Padding="10,5"
                                            Margin="0,0,6,6"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Visibility="{Binding CanRelease, Converter={StaticResource BoolToVis}}"
                                            Click="ClearBooking_Click"
                                            Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="CalendarRemove" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Clear booking" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Padding="10,5"
                                            Margin="0,0,6,6"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Visibility="{Binding CanMarkAvailable, Converter={StaticResource BoolToVis}}"
                                            Click="ReadyForGuests_Click"
                                            Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="BedOutline" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ready for guests" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Padding="10,5"
                                            Margin="0,0,0,6"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="RemoveRoom_Click"
                                            Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Remove" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Footer -->
        <Button Grid.Row="2"
                x:Name="BtnClose"
                HorizontalAlignment="Right"
                Margin="0,14,0,0"
                Padding="20,10"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="BtnClose_Click">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Close" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
