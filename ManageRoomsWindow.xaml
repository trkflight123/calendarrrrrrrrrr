<Window x:Class="calendarrrrrrrrrr.ManageRoomsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Manage Rooms"
        Icon="Assets/manageroom.png"
        Width="500"
        Height="540"
        MinWidth="460"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#C1E1C1"
        d:DesignHeight="540"
        d:DesignWidth="500">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
            <iconPacks:PackIconMaterial Kind="BedDouble"
                                        Width="32"
                                        Height="32"
                                        Foreground="#4A8150"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Manage Rooms"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#4A8150"/>
                <TextBlock Text="Remove rooms that are demolished or no longer in use."
                           FontSize="12"
                           Foreground="#555"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
                <TextBlock Text="Active bookings must be cleared first."
                           FontSize="12"
                           Foreground="#777"/>
            </StackPanel>
        </StackPanel>

        <!-- Room list -->
        <Border Grid.Row="1"
                Background="#F8F8F6"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#D8DDD5"
                BorderThickness="1">
            <ListBox x:Name="RoomsList"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E5E5E5"
                                BorderThickness="0,0,0,1"
                                Padding="4,10,4,10"
                                Margin="0,0,0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="#2D2D2D"/>
                                    <TextBlock Text="{Binding DetailLine}"
                                               FontSize="12"
                                               Foreground="{Binding StatusBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Padding="12,6"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="RemoveRoom_Click"
                                        Tag="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="DeleteOutline"
                                                                    Width="14"
                                                                    Height="14"
                                                                    Margin="0,0,6,0"
                                                                    VerticalAlignment="Center"/>
                                        <TextBlock Text="Remove" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Footer -->
        <Button Grid.Row="2"
                x:Name="BtnClose"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Padding="20,10"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="BtnClose_Click">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Close" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
