<Window x:Class="calendarrrrrrrrrr.GuestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guest List"
        Width="1400"
        Height="900"
        WindowStartupLocation="CenterScreen"
        Background="#C1E1C1"
        ResizeMode="CanResize">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Width="55"
                    Height="55"
                    Background="#4A8150"
                    BorderThickness="0"
                    Foreground="White"
                    FontSize="24"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="Back_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                ←
            </Button>

            <TextBlock Grid.Column="1"
                       Text="Guest / Reservation List"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="#4A8150"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>
        </Grid>

        <Border Grid.Row="1"
                Background="#4A8150"
                CornerRadius="15"
                Padding="25">

            <DataGrid x:Name="GuestGrid"
                      AutoGenerateColumns="False"
                      Background="White"
                      BorderThickness="0"
                      FontSize="15"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="False"
                      CanUserReorderColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeight="40"
                      HeadersVisibility="Column">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Guest Name"
                        Binding="{Binding GuestName}"
                        Width="*"/>

                    <DataGridTextColumn Header="Phone Number"
                        Binding="{Binding Phone}"
                        Width="*"/>

                    <DataGridTextColumn Header="Email"
                        Binding="{Binding Email}"
                        Width="*"/>

                    <DataGridTextColumn Header="Address"
                        Binding="{Binding Address}"
                        Width="*"/>

                    <DataGridTextColumn Header="Room Number"
                        Binding="{Binding RoomNumber}"
                        Width="*"/>

                    <DataGridTextColumn Header="Check In Date"
                        Binding="{Binding CheckInStr}"
                        Width="*"/>

                    <DataGridTextColumn Header="Check Out Date"
                        Binding="{Binding CheckOutStr}"
                        Width="*"/>

                    <DataGridTextColumn Header="Status"
                        Binding="{Binding Status}"
                        Width="*"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>