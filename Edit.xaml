<Window x:Class="calendarrrrrrrrrr.Edit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Reservation"
        Width="500"
        Height="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#C1E1C1">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#ECEEE9"/>
            <Setter Property="BorderBrush" Value="#D8DDD5"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#ECEEE9"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Width" Value="85"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="✎"
                       FontSize="34"
                       Foreground="#4A8150"
                       Margin="0,0,10,0"/>

            <TextBlock Text="Edit Reservation"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#4A8150"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#4A8150"
                Padding="18"
                CornerRadius="8">

            <Border Background="#F8F8F6"
                    CornerRadius="8"
                    Padding="28">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Reservation Form"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#4A8150"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,25"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Last Name" FontSize="12"/>
                                <TextBox x:Name="txtLastName"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="M.I." FontSize="12"/>
                                <TextBox x:Name="txtMI"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="First Name" FontSize="12"/>
                            <TextBox x:Name="txtFirstName"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Phone Number" FontSize="12"/>
                            <TextBox x:Name="txtPhone"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Email Address" FontSize="12"/>
                            <TextBox x:Name="txtEmail"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Address" FontSize="12"/>
                            <TextBox x:Name="txtAddress"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Check In Date" FontSize="12"/>
                                <DatePicker x:Name="dpCheckIn"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Check Out Date" FontSize="12"/>
                                <DatePicker x:Name="dpCheckOut"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Room" FontSize="12"/>
                            <ComboBox x:Name="cmbRoom"
                                      DisplayMemberPath="RoomNumber"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,25">
                            <TextBlock Text="Status" FontSize="12"/>
                            <ComboBox x:Name="cmbStatus">
                                <ComboBoxItem Content="Confirmed"/>
                                <ComboBoxItem Content="Checked In"/>
                                <ComboBoxItem Content="Checked Out"/>
                                <ComboBoxItem Content="Cancelled"/>
                            </ComboBox>
                        </StackPanel>

                        <Grid>
                            <Button Content="Cancel"
                                    Background="#D94B4B"
                                    HorizontalAlignment="Left"
                                    Click="BtnCancel_Click"/>

                            <Button Content="Save"
                                    Background="#4A8150"
                                    HorizontalAlignment="Right"
                                    Click="BtnSave_Click"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</Window>   